# ─── Supabase ────────────────────────────────────────────────────────
# Panel Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Usa la SERVICE_ROLE key (server-side, nunca en el cliente).
# Si solo tienes la anon key, el bot funciona en lectura pero la ingesta puede fallar por RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Opcional (fallback si no hay service role)
# SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── Pinecone ────────────────────────────────────────────────────────
# https://app.pinecone.io → API Keys
PINECONE_API_KEY=pcsk_xxxxxxxx
# Nombre del índice (dimensión 1536, métrica cosine). Default: indexbook-knowledge
PINECONE_INDEX=indexbook-knowledge

# ─── OpenAI ──────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxx
# Modelo de embeddings. text-embedding-3-small = 1536 dims (default)
# text-embedding-3-large = 3072 dims (requiere recrear el índice Pinecone)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Telegram ────────────────────────────────────────────────────────
# Crea el bot con @BotFather y pega el token aquí
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF...
# Etiqueta descriptiva del hosting mostrada en /status (ej: "Hetzner VPS - Falkenstein")
HOST_LABEL=VPS (self-hosted)

# ─── Dashboard de observabilidad ─────────────────────────────────────
# Puerto del monitor web (analítica RAG + salud PM2/host). Si se omite, el
# dashboard queda deshabilitado. Visita http://<host>:<PORT>/
PORT=8787
# Opcional: protege el dashboard con un token (?token=... o header x-dashboard-token)
# DASHBOARD_TOKEN=pon-un-secreto-largo-aqui

# ─── GitHub ──────────────────────────────────────────────────────────
# Token de solo lectura (fine-grained, sin permisos extra basta para repos
# públicos). Sube el rate limit de la API de 60 → 5000 req/h.
# GITHUB_README_TOKEN: bajada de READMEs pendientes (ops/ingest.sh)
# GITHUB_TOKEN: estrellas/forks/actividad para el Trust Score de respaldo
# GITHUB_README_TOKEN=github_pat_...
# GITHUB_TOKEN=github_pat_...

# ─── Operación (alertas) ─────────────────────────────────────────────
# user_id de Telegram que recibe las alertas (caídas, fallos de ingesta).
# Debe haberle escrito /start al bot. Vacío = las alertas solo van al journal.
OPS_CHAT_ID=
