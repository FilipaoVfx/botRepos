# Rotación de logs de PM2 del bot. Instalar: cp ops/logrotate.botrepos /etc/logrotate.d/botrepos
# Solo *.log: logs/events.wal.jsonl es el spool durable de eventos (src/event-log.js)
# y NO se debe rotar.
/root/botRepos/logs/*.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su root root
}
