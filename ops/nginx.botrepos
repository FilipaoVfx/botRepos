# Dashboard de botRepos detrás de nginx (HTTPS con Let's Encrypt vía certbot).
# Host: <ip-con-guiones>.sslip.io (resuelve a la IP del VPS, sin dominio propio).
# Instalar: ver DEPLOY.md §14.
#   cp ops/nginx.botrepos /etc/nginx/sites-available/botrepos
#   ln -s /etc/nginx/sites-available/botrepos /etc/nginx/sites-enabled/
#   cp ops/nginx.botrepos-limits.conf /etc/nginx/conf.d/botrepos-limits.conf
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d <host> --redirect
server {
    listen 80;
    listen [::]:80;
    server_name 2-25-233-186.sslip.io;

    # El panel refresca cada 5 s (0,2 req/s): 5 req/s con ráfaga de 20 sobra para
    # varias pestañas y frena a quien intente adivinar el token.
    limit_req zone=botrepos burst=20 nodelay;
    limit_req_status 429;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
